# Copy to .env and fill in.

# Telegram: create bot via @BotFather, then message it once and read chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  (look for "chat":{"id":...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated pages to watch.
WATCH_URLS=https://www.diljitdosanjh.com/tour/ahmedabad/,https://www.diljitdosanjh.com/tour/

# Poll interval in seconds (random jitter of +-20% added).
INTERVAL_SECONDS=15

# Also open first ticket link in default browser and speak alert on macOS.
OPEN_BROWSER=1
SPEAK=1

# Send "still alive" Telegram ping every N hours (0 = off).
HEARTBEAT_HOURS=6
